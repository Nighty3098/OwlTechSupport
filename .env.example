# ==== Telegram bot ====
# Token from @BotFather
BOT_TOKEN=1234567890:AAA...your-token-here

# Comma-separated telegram user ids that are superadmins (can manage the team)
SUPERADMIN_IDS=123456789,987654321

# ==== Support chat / topic ====
# Plain chat id (group):            3800802201  -> treated as -1003800802201
# Signed chat id:                   -1003800802201
# Public channel/group username:    @owl_support
# Chat with topic via URL:          https://t.me/c/3800802201/37
# Public group URL with topic:      https://t.me/owl_support/37
SUPPORT_CHAT_ID=3800802201

# Optional explicit topic id (overrides topic from SUPPORT_CHAT_ID URL)
SUPPORT_TOPIC_ID=

# ==== Proxy (optional) ====
# Supported schemes: socks5://, socks5h://, socks4://, http://, https://
PROXY_URL=

# ==== Database ====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=owl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=owl_support

# ==== Misc ====
# Contact shown in "contact developer" menu
SUPPORT_CONTACT_URL=https://owl-tech.vercel.app/
